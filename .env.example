# GEMINI_API_KEY / APP_URL: AI Studio scaffolding (unused by Money Tracker core).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Umami Cloud — anonymous pageviews only (no in-app telemetry UI).
# 1. Sign up at https://cloud.umami.is (Hobby free)
# 2. Add a website → copy the Website ID
# 3. Paste below, then restart `npm run dev`
VITE_UMAMI_WEBSITE_ID=""
# Optional override (default: Umami Cloud script)
# VITE_UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"
